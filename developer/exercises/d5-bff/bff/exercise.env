# Exercise D5: header stripping around TokenRelay (application.yml) and CSRF (SecurityConfiguration).
TITLE="D5 BFF header stripping and CSRF (bff)"
REFERENCE=apps/bff
EXCLUDE="README.md"
COMPONENT=java
HELPER=none
TEST_CMD="mvn -B -ntp -q test"
# The BFF jar serves the SPA: package copies the frontend built by D3's package step.
PACKAGE_CMD="bff_static && mvn -B -ntp -q -DskipTests package"
BUILD=binary
DEPLOYMENT=bff
REQUIRES="target/bff.jar"
