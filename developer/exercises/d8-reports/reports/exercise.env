# Exercise D8: the reports client request for operations and the reports runtime configuration.
TITLE="D8 Capstone: the reports consumer"
# reports is the BFF image with its own configuration; the reference is the workshop role's
# reports-config ConfigMap (scripts/tests/test_developer_exercises.py compares the two).
REFERENCE=agd:reports-config
EXCLUDE=""
COMPONENT=python
HELPER=python
HELPER_DEST=.
SETUP_CMD="python3 -c 'import jwt, cryptography, yaml' 2>/dev/null || python3 -m pip install -q PyJWT==2.10.1 cryptography==50.0.2 PyYAML==6.0.3"
TEST_CMD="python3 -B -m unittest discover -s . -p 'test_*.py' -v"
PACKAGE_CMD=""
BUILD=config
DEPLOYMENT=reports
REQUIRES=""
