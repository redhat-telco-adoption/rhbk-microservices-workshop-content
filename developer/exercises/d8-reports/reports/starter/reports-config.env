# Runtime configuration for the reports Deployment (ConfigMap reports-config).
# reports runs the BFF image; these settings make it sign in as its own client.
# bin/exercise.sh rollout fills the @...@ values from your namespace's bff-config.
# The client secret is not configuration: it goes in the reports-client Secret.
OIDC_ISSUER=@OIDC_ISSUER@
KEYCLOAK_HOST=@KEYCLOAK_HOST@
ORDERS_BASE_URL=http://orders-api:8080
LEGACY_BASE_URL=@LEGACY_BASE_URL@
LEGACY_ENABLED=false
SPRING_APPLICATION_NAME=reports
# ANTI-PATTERN: without its own client ID the image signs in as the BFF's client, `bff`,
# and receives the BFF's roles. Exercise D8: set the client registration ID to `reports`.
